{
    // ── Formateo automático al guardar ──────────────────────
    // Cada vez que presionas Ctrl+S, black reformatea el archivo
    // y isort reordena los imports. Así el código SIEMPRE cumple
    // las reglas antes de llegar al commit.
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },

    // ── Python ──────────────────────────────────────────────
    "python.analysis.typeCheckingMode": "basic",

    // ── Black (formateador) ─────────────────────────────────
    "black-formatter.args": ["--line-length=88"],

    // ── isort (ordenador de imports) ────────────────────────
    "isort.args": ["--profile=black"],

    // ── Flake8 (linter) ─────────────────────────────────────
    // Muestra errores en tiempo real como subrayados rojos/amarillos
    "flake8.args": ["--max-line-length=88", "--extend-ignore=W503"],

    // ── Archivos ────────────────────────────────────────────
    // Asegura newline al final y elimina espacios trailing
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.encoding": "utf8",

    // ── Regla de 88 caracteres visible ──────────────────────
    "editor.rulers": [88],
    "editor.tabSize": 4,
    "editor.insertSpaces": true
}
